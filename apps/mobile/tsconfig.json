{
  "compilerOptions": {
    "target": "ES2020",
    "module": "preserve",
    "jsx": "react-native",
    "declaration": true,
    "rootDir": "../../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
