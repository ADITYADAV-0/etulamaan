generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "mongodb"
	url      = env("DATABASE_URL")
}

enum Role {
	OWNER
	LMO
	GATC
	ADMIN
}
enum KycStatus {
	PENDING
	VERIFIED
	REJECTED
}
enum ApplicationType {
	NEW
	REVERIFICATION
}
enum ApplicationStatus {
	SUBMITTED
	SCHEDULED
	INSPECTED
	CERTIFIED
	REJECTED
}
enum PaymentStatus {
	PENDING
	PAID
	FAILED
}
enum InspectionResult {
	PASS
	FAIL
}
enum CertificateStatus {
	VALID
	EXPIRED
	REVOKED
}
enum NotificationChannel {
	INBOX
	EMAIL
	SMS
}

model User {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	name String
	email String @unique
	phone String?
	passwordHash String
	role Role
	jurisdiction String?
	kycStatus KycStatus @default(PENDING)
	totpSecret String?
	locale String @default("en")
	instruments Instrument[]
	applications Application[]
	assignedInspections Inspection[]
	notifications Notification[]
	auditLogs AuditLog[]
	createdAt DateTime @default(now())
}

model Instrument {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	ownerId String @db.ObjectId
	owner User @relation(fields: [ownerId], references: [id])
	category String
	make String
	model String
	capacity String
	serialNo String @unique
	location String
	createdAt DateTime @default(now())
	applications Application[]
	certificates Certificate[]
}

model Application {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	instrumentId String @db.ObjectId
	instrument Instrument @relation(fields: [instrumentId], references: [id])
	type ApplicationType
	status ApplicationStatus @default(SUBMITTED)
	feeAmountPaise Int
	paymentStatus PaymentStatus @default(PENDING)
	assignedOfficerId String? @db.ObjectId
	assignedOfficer User? @relation(fields: [assignedOfficerId], references: [id])
	scheduledFor DateTime?
	createdAt DateTime @default(now())
	documents Document[]
	inspections Inspection[]
	certificates Certificate[]
	deficiencyMemos DeficiencyMemo[]
	payments Payment[]
}

model Document {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	applicationId String @db.ObjectId
	application Application @relation(fields: [applicationId], references: [id])
	kind String
	filename String
	path String
}

model Inspection {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	applicationId String @db.ObjectId
	application Application @relation(fields: [applicationId], references: [id])
	officerId String @db.ObjectId
	officer User @relation(fields: [officerId], references: [id])
	checklistJson Json
	readingsJson Json
	remarks String?
	result InspectionResult
	lat Float?
	lng Float?
	evidencePaths Json
	submittedAt DateTime @default(now())
}

model Certificate {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	applicationId String @db.ObjectId
	application Application @relation(fields: [applicationId], references: [id])
	instrumentId String @db.ObjectId
	instrument Instrument @relation(fields: [instrumentId], references: [id])
	certNo String @unique
	contentHash String
	signature String
	issuedAt DateTime
	validUntil DateTime
	status CertificateStatus @default(VALID)
	revokedReason String?
}

model DeficiencyMemo {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	applicationId String @db.ObjectId
	application Application @relation(fields: [applicationId], references: [id])
	notes String
	issuedAt DateTime @default(now())
}

model Payment {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	applicationId String @db.ObjectId
	application Application @relation(fields: [applicationId], references: [id])
	amountPaise Int
	status PaymentStatus
	gatewayRef String?
	createdAt DateTime @default(now())
}

model Notification {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	userId String @db.ObjectId
	user User @relation(fields: [userId], references: [id])
	channel NotificationChannel
	title String
	body String
	readAt DateTime?
	createdAt DateTime @default(now())
}

model AuditLog {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	actorId String? @db.ObjectId
	actor User? @relation(fields: [actorId], references: [id])
	action String
	entity String
	entityId String
	meta Json
	timestamp DateTime @default(now())
}

model MasterCategory {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	name String @unique
	validityMonths Int
	baseFeePaise Int
	checklistTemplateJson Json
}

model Grievance {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	shopName String
	location String
	photoPath String?
	note String
	jurisdiction String?
	status String @default("OPEN")
	createdAt DateTime @default(now())
}
